{
  "format": "ink-studio/material-graph",
  "version": 1,
  "id": "tile",
  "graph": {
    "inputs": {
      "resolution": {
        "definition": {
          "type": "number",
          "default": 128
        }
      },
      "seed": {
        "definition": {
          "type": "number",
          "default": 41
        }
      },
      "relief": {
        "definition": {
          "type": "number",
          "default": 1.4
        }
      },
      "count": {
        "definition": {
          "type": "number",
          "default": 3
        }
      },
      "joint": {
        "definition": {
          "type": "number",
          "default": 0.095
        }
      },
      "ornament": {
        "definition": {
          "type": "number",
          "default": 0.92
        }
      }
    },
    "nodes": {
      "glazeGapParts": {
        "op": "data.record",
        "inputs": {}
      },
      "glazeGap": {
        "op": "data.collect",
        "inputs": {
          "keys": [
            "item0",
            "item1"
          ]
        }
      },
      "glazedSquaresOptions": {
        "op": "data.record",
        "inputs": {
          "samples": 2,
          "palette": [
            "#23575a",
            "#326e6b",
            "#397b73",
            "#2c6464"
          ],
          "background": "#1f2931",
          "jitter": {
            "color": 0.12
          }
        }
      },
      "glazedSquares": {
        "op": "image.tileGenerator",
        "inputs": {
          "stamp": {
            "type": "rectangle",
            "size": [
              1,
              1
            ],
            "radius": 0.14
          }
        }
      },
      "compassRoseOptions": {
        "op": "data.record",
        "inputs": {
          "samples": 2,
          "color": "#e9b079"
        }
      },
      "compassRose": {
        "op": "image.tileGenerator",
        "inputs": {
          "stamp": {
            "type": "symbol",
            "parts": [
              {
                "shape": {
                  "type": "star",
                  "tips": 4,
                  "radius": 0.391,
                  "innerRadius": 0.114
                }
              },
              {
                "shape": {
                  "type": "disc",
                  "radius": 0.34
                }
              },
              {
                "op": "subtract",
                "shape": {
                  "type": "disc",
                  "radius": 0.316
                }
              },
              {
                "shape": {
                  "type": "star",
                  "tips": 4,
                  "radius": 0.306,
                  "innerRadius": 0.115
                }
              },
              {
                "op": "subtract",
                "shape": {
                  "type": "disc",
                  "radius": 0.044
                }
              }
            ]
          }
        }
      },
      "glazedSquaresCoverageSamples": {
        "op": "image.toRaster",
        "inputs": {}
      },
      "glazedSquaresCoverage": {
        "op": "image.declare",
        "inputs": {
          "descriptor": {
            "intent": "mask",
            "precision": "float32",
            "sampling": "linear",
            "tiling": {
              "u": "wrap",
              "v": "wrap"
            }
          }
        }
      },
      "compassRoseCoverageSamples": {
        "op": "image.toRaster",
        "inputs": {}
      },
      "compassRoseCoverage": {
        "op": "image.declare",
        "inputs": {
          "descriptor": {
            "intent": "mask",
            "precision": "float32",
            "sampling": "linear",
            "tiling": {
              "u": "wrap",
              "v": "wrap"
            }
          }
        }
      },
      "glazeAndSlip": {
        "op": "image.blend",
        "inputs": {
          "mode": "copy"
        }
      },
      "engravingDepth": {
        "op": "image.channelMath",
        "inputs": {
          "operation": "multiply",
          "options": {
            "precision": "float32"
          }
        }
      },
      "ceramicBevelOptions": {
        "op": "data.record",
        "inputs": {
          "width": 3.5,
          "height": 1,
          "profile": "smooth"
        }
      },
      "ceramicBevel": {
        "op": "image.bevel",
        "inputs": {}
      },
      "ceramicSurfaceSamples": {
        "op": "image.toRaster",
        "inputs": {}
      },
      "ceramicSurface": {
        "op": "image.declare",
        "inputs": {
          "descriptor": {
            "intent": "data",
            "precision": "float32",
            "sampling": "linear",
            "tiling": {
              "u": "wrap",
              "v": "wrap"
            }
          }
        }
      },
      "glazeReliefBase": {
        "op": "image.convert",
        "inputs": {
          "descriptor": {
            "intent": "data",
            "precision": "float32"
          }
        }
      },
      "glazeReliefField": {
        "op": "image.convert",
        "inputs": {
          "descriptor": {
            "intent": "data",
            "precision": "float32"
          }
        }
      },
      "glazeReliefDetail": {
        "op": "image.channelMath",
        "inputs": {
          "b": -0.37,
          "operation": "multiply",
          "options": {
            "precision": "float32"
          }
        }
      },
      "glazeRelief": {
        "op": "image.channelMath",
        "inputs": {
          "operation": "add",
          "options": {
            "precision": "float32"
          }
        }
      },
      "materialHeight": {
        "op": "image.toHeight",
        "inputs": {
          "units": "art-px"
        }
      },
      "tangentNormal": {
        "op": "image.heightToNormal",
        "inputs": {
          "options": {
            "method": "central",
            "border": "wrap"
          }
        }
      },
      "roughnessResponse": {
        "op": "image.curve",
        "inputs": {
          "curve": {
            "stops": [
              [
                0,
                0.79
              ],
              [
                1,
                0.22
              ]
            ],
            "interpolation": "smooth"
          }
        }
      },
      "previewLight": {
        "op": "image.emboss",
        "inputs": {
          "options": {
            "azimuth": -135,
            "elevation": 37,
            "strength": 0.86,
            "bias": 0.68,
            "border": "wrap"
          }
        }
      },
      "previewLightRamp": {
        "op": "image.gradientMap",
        "inputs": {
          "ramp": {
            "stops": [
              [
                0,
                "#382947"
              ],
              [
                0.29,
                "#776477"
              ],
              [
                0.68,
                "#e8e2db"
              ],
              [
                1,
                "#fff8e6"
              ]
            ],
            "interpolation": "smooth"
          },
          "options": {
            "precision": "unorm8"
          }
        }
      },
      "preview": {
        "op": "image.blend",
        "inputs": {
          "mode": "multiply",
          "opacity": 0.89
        }
      },
      "displayPreview": {
        "op": "image.toDisplay",
        "inputs": {}
      }
