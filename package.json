{
  "name": "@shapeshift-labs/ink-studio",
  "version": "0.1.0",
  "private": true,
  "description": "SDF sculpting and pixel-art Gaussian splats with browser and headless renderers",
  "main": "index.js",
  "browser": "./webgl.mjs",
  "files": [
    "index.js",
    "webgl.mjs",
    "webgpu.mjs",
    "show-control.mjs",
    "src/",
    "cli/",
    "scripts/",
    "demos/",
    "lab/",
    "examples/",
    "materials/",
    "docs/",
    "catalog.json",
    "storage-retention.json",
    "dist/ink-studio.browser.js",
    "dist/ink-studio.bake.js",
    "dist/ink-studio.node.cjs",
    "dist/ink-studio.player.mjs"
  ],
  "bin": {
    "ink-studio": "cli/ink-studio.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "node scripts/build.js --quiet",
    "prepack": "node scripts/reference.js --check --quiet",
    "pretest": "npm run docs:check && node scripts/build.js node",
    "test": "node --test tests/*.test.js && node cli/ink-studio.js selftest",
    "lint": "node scripts/check.js",
    "docs:build": "node scripts/reference.js",
    "docs:check": "node scripts/reference.js --check",
    "format": "prettier --write \"src/**/*.js\" \"cli/*.js\" \"demos/*.js\" \"lab/*.js\" index.js \"scripts/*.js\""
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": "github:siliconjungle/shapeshift-labs-ink-studio"
}
