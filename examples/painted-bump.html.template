<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Signal Works · Painted bump</title>
<style>
  :root { color-scheme:dark; background:#10181c; color:#f3ead5; font:15px system-ui,sans-serif; }
  * { box-sizing:border-box; }
  body { margin:0; }
  main { width:min(1140px,calc(100% - 36px)); margin:auto; padding:28px 0 36px; }
  h1 { margin:0; font:400 clamp(34px,7vw,60px)/1 Georgia,serif; letter-spacing:-.04em; }
  header p { margin:8px 0 20px; color:#bdcec6; }
  .panels { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
  figure { margin:0; background:#17252a; border:1px solid #4b605c; border-radius:5px; overflow:hidden; }
  figure:nth-child(2) { border-color:#a0875a; }
  canvas { display:block; width:100%; image-rendering:pixelated; aspect-ratio:168 / 104; }
  #height { cursor:crosshair; touch-action:none; }
  figcaption { border-top:1px solid #4b605c; padding:10px; text-align:center; font-weight:650; }
  figure:nth-child(2) figcaption { color:#e8c684; }
  .controls { padding:16px 0; display:flex; align-items:center; gap:10px 17px; flex-wrap:wrap; }
  label { display:flex; gap:8px; align-items:center; }
  label:has(input) { flex:1 1 200px; }
  input[type=range] { accent-color:#e5b972; flex:1; min-width:55px; }
  output { min-width:39px; font-variant-numeric:tabular-nums; color:#bdcec6; }
  button, a, select { font:inherit; padding:7px 10px; color:inherit; background:#273738;
    border:1px solid #647570; border-radius:4px; text-decoration:none; }
  button, select { cursor:pointer; }
  button:disabled { opacity:.55; cursor:default; }
  nav { display:flex; flex-wrap:wrap; gap:8px; }
  #status { color:#bdcec6; margin:0 0 12px; }
  @media (max-width:550px) {
    main { width:calc(100% - 20px); padding:16px 0; }
    .panels { gap:6px; grid-template-columns:repeat(2,minmax(0,1fr)); }
    figure:nth-child(2) { grid-row:1; grid-column:1 / -1; }
    figcaption { padding:6px 2px; font-size:13px; }
    .controls { gap:7px 10px; }
  }
</style>
<main>
  <header><h1>Signal Works</h1><p>Paint relief in the middle panel, then move the light across the sign.</p></header>
  <div class="panels">
    <figure><canvas id="flat" aria-label="Signal Works sign lit as flat paint"></canvas><figcaption>Flat light</figcaption></figure>
    <figure><canvas id="height" aria-label="Editable height paint for the sign and wall"></canvas><figcaption>Height paint</figcaption></figure>
    <figure><canvas id="relief" aria-label="Signal Works sign lit with painted bumps"></canvas><figcaption>Bump light</figcaption></figure>
  </div>
  <section class="controls" aria-label="Brush and light controls">
    <label>Brush <select id="brush"><option value="2">Raise</option><option value="-2">Recess</option><option value="0">Flatten</option></select></label>
    <label>Size <input id="size" type="range" min="1" max="15" value="5"><output id="size-value" for="size">5 px</output></label>
    <label>Light <input id="light" type="range" min="-80" max="80" value="-48"><output id="light-value" for="light">−48°</output></label>
    <button id="undo" type="button" disabled>Undo</button>
    <button id="reset" type="button" disabled>Reset paint</button>
  </section>
  <p id="status" role="status" hidden></p>
  <nav aria-label="Download the painted atlas">
    <a id="download" download="signal-works-atlas.json" href="#">Atlas JSON</a>
    <a id="color" download="signal-works-color.png">Color PNG</a>
  </nav>
</main>
<script type="module">
/* ATLAS */
/* LIGHT */
const { metadata, color, png } = /* DATA */;
const get = id => document.getElementById(id);
const images = {color:Uint8Array.from(atob(color),value=>value.charCodeAt(0))};
const { width, height } = metadata, authored = metadata.bump.paint;
const brush = get('brush'), light = get('light'), size = get('size'), editor = get('height');
const undo = get('undo'), reset = get('reset'), status = get('status');
const panels = ['flat','height','relief'].map(name=>{
  const canvas=get(name);
  canvas.width=width;
  canvas.height=height;
  return canvas.getContext('2d',{willReadFrequently:true});
});
const flat = AtlasSprites.compile({ metadata:{...metadata,bump:false}, images });
let edits = [], current, pointer, raised, changed = true, queued = false;
get('color').href=png;

function definition() {
  return {...metadata,bump:{...metadata.bump,paint:[...authored,...edits]}};
}

function shade(field,index,sample,direction) {
  const gain=sample.hasNormal
    ? .47+.72*Math.max(0,AtlasSprites.dot(sample.normal,direction)/Math.hypot(...sample.normal))
    : 1;
  for(let c=0;c<3;c++)field.data[index+c]=sample.color[c]*gain*255;
  field.data[index+3]=sample.alpha*255;
}

function draw() {
  queued=false;
  if(changed) { raised=AtlasSprites.compile({metadata:definition(),images}); changed=false; }
  const direction=lightDirection(Number(light.value));
  const frame=raised.select(), baseline=flat.select();
  const fields=panels.map(context=>context.createImageData(width,height));
  const base={color:[],normal:[],emission:[]}, bump={color:[],normal:[],emission:[]};
  for(let y=0;y<height;y++)for(let x=0;x<width;x++){
    if(!flat.sample(baseline,x,y,{},base))continue;
    const index=(y*width+x)*4;
    raised.sample(frame,x,y,{},bump);
    const value=raised.bumpHeight(x,y);
    const tone=Math.max(0,Math.min(255,Math.round(75+value*39)));
    fields[1].data.set([tone,tone,tone,base.alpha*255],index);
    shade(fields[0],index,base,direction);
    shade(fields[2],index,bump,direction);
  }
  panels.forEach((context,index)=>context.putImageData(fields[index],0,0));
  get('size-value').textContent=size.value+' px';
  get('light-value').textContent=light.value+'°';
  undo.disabled=reset.disabled=!edits.length;
}

function redraw(paint=false) {
  changed ||= paint;
  if(!queued) { queued=true; requestAnimationFrame(draw); }
}

function point(event) {
  const rect=editor.getBoundingClientRect();
  return [Math.min(width-1,Math.max(0,Math.floor((event.clientX-rect.left)*width/rect.width)))+.5,
    Math.min(height-1,Math.max(0,Math.floor((event.clientY-rect.top)*height/rect.height)))+.5];
}

editor.onpointerdown=event=>{
  if(current||event.button!==0)return;
  if(authored.length+edits.length>=512){status.textContent='The atlas has reached 512 strokes.';status.hidden=false;return;}
  const at=point(event);
  current={height:Number(brush.value),shape:{type:'path',width:Number(size.value),points:[at,at]}};
  edits.push(current);
  pointer=event.pointerId;
  editor.setPointerCapture(pointer);
  redraw(true);
};
function extendStroke(event) {
  if(!current||event.pointerId!==pointer)return;
  const at=point(event), points=current.shape.points, last=points.at(-1);
  if((at[0]!==last[0]||at[1]!==last[1])&&points.length<512){points.push(at);redraw(true);}
}
function stopStroke(event) {
  if(event.pointerId!==pointer)return;
  current=pointer=undefined;
}
editor.onpointermove=extendStroke;
editor.onpointerup=event=>{extendStroke(event);stopStroke(event);};
editor.onpointercancel=editor.onlostpointercapture=stopStroke;
undo.onclick=()=>{edits.pop();status.hidden=true;redraw(true);};
reset.onclick=()=>{edits=[];status.hidden=true;redraw(true);};
size.oninput=()=>redraw();
light.oninput=()=>redraw();
get('download').onclick=event=>{
  event.preventDefault();
  const blob=new Blob([JSON.stringify({...definition(),files:{color:'signal-works-color.png'}},null,2)],{type:'application/json'});
  const link=document.createElement('a');
  link.download='signal-works-atlas.json';
  link.href=URL.createObjectURL(blob);
  link.click();
  setTimeout(()=>URL.revokeObjectURL(link.href),1000);
};
draw();
</script>
</html>
