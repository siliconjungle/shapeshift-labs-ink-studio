{
  "format": "ink-studio/world",
  "version": 1,
  "id": "tide-calendar",
  "seed": 13,
  "dt": 0.1,
  "storyDocuments": [{ "file": "tide-calendar.json" }],
  "storyteller": {
    "active": "harbor-log",
    "profiles": { "harbor-log": { "cadence": { "minInterval": 0.3 }, "challenge": { "maxIntensity": 3 },
      "variety": { "family": 1 } } }
  },
  "systems": {
