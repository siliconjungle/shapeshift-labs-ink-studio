{
  "format": "ink-studio/world",
  "version": 1,
  "id": "relief-crossing",
  "dt": 0.1,
  "storyDocuments": [{ "file": "relief-crossing.json" }],
  "entities": {
    "north-shelter": { "position": [1.35, 0, 0.5] },
    "south-shelter": { "position": [1.35, 0, -0.5] }
  },
  "systems": {
    "supplies": {
      "kind": "store",
      "config": { "accounts": {
        "reserve": { "resource": "medicine", "units": "crate", "type": "integer", "initial": 4, "max": 4 },
        "depot": { "resource": "medicine", "units": "crate", "type": "integer", "initial": 2, "max": 6 },
        "landing": { "resource": "medicine", "units": "crate", "type": "integer", "initial": 0, "max": 6 }
      } }
    },
    "rig": {
      "kind": "mechanics",
      "config": {
        "bodies": {
          "brace": {
            "fixed": true,
            "position": [0, 0.25, 2],
            "half": [0.5, 0.12, 0.12],
            "structure": { "axis": 0, "sections": 2, "plastic": { "yield": 90, "creep": 0.08, "limit": 1 } }
          }
        },
        "forces": {
          "press": { "kind": "thrust", "body": "brace", "axis": [0, -1, 0], "magnitude": 8, "input": 1 }
        }
      }
    },
    "workshop": {
      "kind": "logistics",
      "config": {
        "resources": { "mortar": { "type": "integer", "units": "bag" } },
        "containers": { "yard": { "stocks": { "mortar": { "initial": 1, "max": 1 } } } },
        "recipes": { "repair": { "duration": 0.6, "inputs": { "mortar": 1 } } },
        "processes": { "plaster": {
          "recipe": "repair",
          "inputs": { "mortar": "yard" },
          "work": {
            "at": [0, 0, 2], "radius": 0.6, "batches": 1,
            "effect": { "action": "rig/repair", "args": { "body": "brace" } }
          }
        } }
      }
    },
    "crew": {
      "kind": "agents",
      "config": {
        "bounds": { "min": [-2, -0.5, -1], "max": [2, 1, 3] },
        "ground": 0,
        "cell": 0.2,
        "species": { "evacuee": { "mode": "walk", "radius": 0.1, "speed": 2 } },
        "agents": {
          "scout": { "species": "evacuee", "position": [-1, 0, 0.5] },
          "medic": { "species": "evacuee", "position": [0, 0, 2] }
        },
        "orders": { "tasks": {
          "mend": { "steps": [{ "op": "work", "site": "workshop/plaster" }] },
          "move": { "steps": [{ "op": "move", "at": { "target": "site" } }] }
        } }
      }
    }
  },
  "commands": [
    { "tick": 1, "action": "crew/issue-order", "args": { "agent": "medic", "order": { "id": "repair-brace", "task": "mend" } } },
    { "tick": 2, "action": "world/transfer", "args": { "id": "small-delivery", "from": "supplies/depot", "to": "supplies/landing", "amount": 4 } },
    { "tick": 3, "action": "world/input", "args": { "port": "rig/force.press", "value": 0 } },
    { "tick": 3, "action": "world/story-choose", "args": { "document": "relief-crossing", "story": "evacuate", "stage": "prepare", "visit": 1, "branch": "cross", "reason": "check-readiness" } },
    { "tick": 4, "action": "world/transfer", "args": { "id": "replenish-depot", "from": "supplies/reserve", "to": "supplies/depot", "amount": 4 } },
    { "tick": 5, "action": "world/transfer", "args": { "id": "complete-delivery", "from": "supplies/depot", "to": "supplies/landing", "amount": 4, "mode": "exact" } }
  ],
  "eventActions": {
    "open-crossing": {
      "on": { "kind": "story-objective-resolved", "system": "world", "where": { "path": "/objective", "value": "mend-brace" } },
      "actions": [{ "action": "world/story-choose", "args": {
        "document": "relief-crossing", "story": "evacuate", "stage": "prepare", "visit": 1, "branch": "cross", "reason": "brace-inspected"
      } }]
    },
    "send-crew": {
      "on": { "kind": "story-stage-entered", "system": "world", "where": { "path": "/stage", "value": "crossing" } },
      "actions": [
        { "action": "crew/issue-order", "args": { "agent": "scout", "order": { "id": "scout-to-shelter", "task": "move", "targets": { "site": { "entity": "north-shelter" } } } } },
        { "action": "crew/issue-order", "args": { "agent": "medic", "order": { "id": "medic-to-shelter", "task": "move", "targets": { "site": { "entity": "south-shelter" } } } } }
      ]
    },
    "close-story": {
      "on": { "kind": "story-objective-resolved", "system": "world", "where": { "path": "/objective", "value": "party-safe" } },
      "actions": [{ "action": "world/story-choose", "args": {
        "document": "relief-crossing", "story": "evacuate", "stage": "crossing", "visit": 2, "branch": "close", "reason": "safety-confirmed"
      } }]
    }
  }
}
