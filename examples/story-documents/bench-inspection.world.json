{
  "format": "ink-studio/world",
  "version": 1,
  "id": "bench-inspection-native",
  "dt": 0.1,
  "storyDocuments": [{ "file": "bench-inspection.json" }],
  "entities": { "workbench": { "position": [0, 0, 0] } },
  "systems": {
    "bench": { "kind": "targeted-interactions", "config": {
      "verbs": { "inspect": { "range": 0.6, "ticks": 1 } },
      "targets": { "crate": { "at": { "entity": "workbench" }, "verbs": {
        "inspect": { "effect": { "action": "world/transfer", "args": {
          "from": "station/raw", "to": "station/approved", "amount": 2
        } } }
      } } }
    } },
    "crew": { "kind": "agents", "config": {
      "bounds": { "min": [-2, -0.5, -1], "max": [2, 1, 1] },
      "ground": 0, "cell": 0.2,
      "species": { "worker": { "mode": "walk", "radius": 0.1, "speed": 2 } },
      "agents": { "mira": { "species": "worker", "position": [0, 0, 0] } },
      "orders": { "tasks": { "inspect": { "steps": [
        { "op": "interact", "system": "bench", "target": "crate", "verb": "inspect" }
      ] } } }
    } },
    "station": { "kind": "store", "config": { "accounts": {
      "raw": { "resource": "spares", "units": "part", "type": "integer", "initial": 2 },
      "approved": { "resource": "spares", "units": "part", "type": "integer", "initial": 0 }
    } } },
    "harbor": { "kind": "store", "config": { "accounts": {
      "pier": { "resource": "spares", "units": "part", "type": "integer", "initial": 0 }
    } } }
  }
}
