{
  "format": "ink-studio/story",
  "version": 1,
  "id": "beacon-dispatch",
  "title": "Send an escort to the flood beacon",
  "stories": {
    "response": {
      "kind": "questlet",
      "title": "Reach the beacon landing",
      "entry": "respond",
      "roles": { "escort": { "kind": "field-escort", "required": true } },
      "lifecycle": { "progression": true },
      "triggers": { "call": { "event": { "kind": "beacon-call", "system": "world" } } },
      "stages": {
        "respond": {
          "title": "Go to the landing",
          "roles": ["escort"],
          "objectives": {
            "arrive": {
              "title": "The cast escort reaches the landing",
              "type": "reach",
              "params": {
                "system": { "$role": "escort", "path": "/system" },
                "agent": { "$role": "escort", "path": "/agent" },
                "generation": { "$role": "escort", "path": "/generation" },
                "min": [0.1, -0.1, -0.1],
                "max": [0.4, 0.1, 0.1]
              }
            }
          },
          "next": { "finish": { "outcome": "arrived" } }
        }
      },
      "outcomes": { "arrived": { "title": "Escort reached the beacon" } }
    }
  }
}
