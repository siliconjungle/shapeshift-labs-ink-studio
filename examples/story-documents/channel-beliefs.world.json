      "from": { "kind": "actor", "id": "crew/niko" }, "to": { "kind": "faction", "id": "harbor-watch" }
    } },
    { "tick": 3, "action": "world/fact", "args": {
      "type": "channel-inspection", "at": { "place": "harbor/east-channel" }, "data": { "state": "closed" },
