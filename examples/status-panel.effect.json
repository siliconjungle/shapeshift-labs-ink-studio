{
  "format": "ink-studio/effect-clip",
  "version": 1,
  "id": "status-panel",
  "title": "Status Panel",
  "duration": 2.4,
  "fps": 24,
  "cues": {"check": {"at": 0.3, "label": "Meter check"}, "signal": {"at": 0.95, "label": "Signal on"}, "reset": {"at": 1.9, "label": "Reset"}},
  "parameters": {"power": {"label": "Lamp brightness", "default": 1, "min": 0, "max": 1}},
  "lanes": {
    "meter": {"label": "Meter", "keys": [
        {"at": 0, "value": 0},
        {"cue": "check", "value": 0.3},
        {"cue": "signal", "value": 0.9, "offset": -0.06},
        {"cue": "signal", "value": 0.6, "offset": 0.18},
        {"cue": "reset", "value": 0.15},
        {"at": 2.4, "value": 0}
      ]
    },
    "lamp": {"label": "Lamp", "keys": [
        {"at": 0, "value": 0},
        {"cue": "signal", "value": 0, "offset": -0.08},
        {"cue": "signal", "value": 1},
        {"cue": "signal", "value": 1, "offset": 0.15},
        {"cue": "reset", "value": 0},
        {"at": 2.4, "value": 0}
      ]
    },
    "status": {"label": "Status bars", "keys": [
        {"at": 0, "value": 0},
        {"cue": "signal", "value": 0.15, "offset": -0.08},
        {"cue": "signal", "value": 1},
        {"cue": "reset", "value": 0.4},
        {"at": 2.4, "value": 0}
      ]
    }
  },
  "graph": {
    "nodes": {
      "clear": {"op": "raster.canvas", "inputs": {"width": 64, "height": 40}},
      "panel": {"op": "draw.render", "inputs": {"width": 64, "height": 40, "edges": "hard", "commands": [
        {"type": "rect", "rect": [0, 0, 64, 40], "fill": "#131a27"},
        {"type": "rect", "rect": [4, 6, 56, 28], "fill": "#465569"},
        {"type": "rect", "rect": [5, 7, 54, 26], "fill": "#202d40"},
        {"type": "rect", "rect": [9, 12, 18, 16], "fill": "#354257"},
        {"type": "rect", "rect": [32, 12, 23, 6], "fill": "#354257"},
        {"type": "rect", "rect": [32, 22, 23, 6], "fill": "#354257"}
      ]}},
      "meterFace": {"op": "draw.render", "inputs": {"width": 64, "height": 40, "edges": "hard", "commands": [
        {"type": "rect", "rect": [33, 13, 20, 4], "fill": "#5fd4c8"}
      ]}},
      "lampFace": {"op": "draw.render", "inputs": {"width": 64, "height": 40, "edges": "hard", "commands": [
        {"type": "ellipse", "rect": [11, 13, 14, 14], "fill": "#ffe5a0"}
      ]}},
      "statusFace": {"op": "draw.render", "inputs": {"width": 64, "height": 40, "edges": "hard", "commands": [
        {"type": "rect", "rect": [33, 23, 5, 4], "fill": "#7bd09e"},
        {"type": "rect", "rect": [40, 23, 5, 4], "fill": "#7bd09e"},
        {"type": "rect", "rect": [47, 23, 5, 4], "fill": "#7bd09e"}
      ]}},
      "meterOpacity": {"op": "data.record", "inputs": {"opacity": {"node": "lane-meter"}}},
      "poweredLamp": {"op": "multiply", "inputs": {"a": {"node": "lane-lamp"}, "b": {"input": "power"}}},
      "lampOpacity": {"op": "data.record", "inputs": {"opacity": {"node": "poweredLamp"}}},
      "statusOpacity": {"op": "data.record", "inputs": {"opacity": {"node": "lane-status"}}},
      "meter": {"op": "raster.blend", "inputs": {"foreground": {"node": "meterFace"}, "background": {"node": "clear"}, "options": {"node": "meterOpacity"}}},
      "lamp": {"op": "raster.blend", "inputs": {"foreground": {"node": "lampFace"}, "background": {"node": "clear"}, "options": {"node": "lampOpacity"}}},
      "status": {"op": "raster.blend", "inputs": {"foreground": {"node": "statusFace"}, "background": {"node": "clear"}, "options": {"node": "statusOpacity"}}},
      "withMeter": {"op": "raster.blend", "inputs": {"foreground": {"node": "meter"}, "background": {"node": "panel"}}},
      "withLamp": {"op": "raster.blend", "inputs": {"foreground": {"node": "lamp"}, "background": {"node": "withMeter"}}},
      "beauty": {"op": "raster.blend", "inputs": {"foreground": {"node": "status"}, "background": {"node": "withLamp"}}},
      "intensity": {"op": "raster.channel", "inputs": {"source": {"node": "lamp"}, "options": {"channel": "alpha"}}}
    },
    "outputs": {
      "beauty": {"node": "beauty"},
      "meter": {"node": "meter"},
      "lamp": {"node": "lamp"},
      "status": {"node": "status"},
      "lampLevel": {"node": "lane-lamp"}
    }
  },
  "previews": {"intensity": {"node": "intensity", "port": "value", "label": "Lamp opacity"}},
  "pins": ["beauty", "meter", "lamp", "status"]
}
