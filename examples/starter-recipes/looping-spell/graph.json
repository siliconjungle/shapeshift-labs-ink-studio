  "outputs": {
    "spell": { "node": "spell" },
    "core": { "node": "rune" }
  },
  "exports": {
    "spell": { "output": "spell", "format": "png" },
    "core": { "output": "core", "format": "png" }
  },
  "assertions": [
    { "id": "spell-width", "output": "spell", "path": [ "width" ], "op": "eq", "value": 112 }
  ]
