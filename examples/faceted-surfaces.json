{
  "format": "ink-studio/graph-project",
  "version": 1,
  "nodes": {
    "shape": {
      "op": "sdf.shape",
      "inputs": {
        "kind": "box",
        "options": {
          "half": [
            0.8,
            1,
            0.6
          ],
          "round": 0.14
        }
      }
    },
    "patches": {
      "op": "sdf.facets",
      "inputs": {
        "source": {
          "node": "shape",
          "port": "value"
        },
        "options": {
          "size": [
            0.24,
            0.38,
            0.24
          ],
          "appearance": {
            "palette": [
              "#685678",
              "#a4879f"
            ],
            "grouping": "normal"
          }
        }
      }
    },
    "object": {
      "op": "scene.object",
      "inputs": {
        "source": {
          "node": "patches",
          "port": "mesh"
        },
        "options": {
          "id": "housing",
          "facets": true
        }
      }
    },
    "records": {
      "op": "data.record",
      "inputs": {
        "housing": {
          "node": "object",
          "port": "value"
        }
      }
    },
    "objects": {
      "op": "data.collect",
      "inputs": {
        "source": {
          "node": "records",
          "port": "value"
        },
        "keys": [
          "housing"
        ]
      }
    },
    "world": {
      "op": "scene.world",
      "inputs": {
        "objects": {
          "node": "objects",
          "port": "value"
        },
        "options": {
          "background": "#101725",
          "camera": {
            "dist": 4.5,
            "yaw": 0.5,
            "pitch": 0.25
          }
        }
      }
    },
    "render": {
      "op": "scene.render",
      "inputs": {
        "source": {
          "node": "world",
          "port": "value"
        },
        "options": {
          "width": 480,
          "height": 480
        }
      }
    }
  },
  "outputs": {
    "image": {
      "node": "render",
      "port": "value"
    },
    "plan": {
      "node": "patches",
      "port": "value"
    }
  },
  "exports": {
    "image": {
      "output": "image",
      "format": "png"
    },
    "plan": {
      "output": "plan",
      "format": "json"
    }
  }
}
